*.syx
*.zip
*_readme.html
sections/
out/
venv/
__pycache__/
*.pyc
vendor/
snapshots/
*.snap
*.mstate

# uv
.venv/

# NXP reference manuals: ~11 MB of vendor PDF, plus the text dump generated
# from one of them. Fetch your own copies; the notes extracted from them
# (docs/refs/*.md) are committed and cite chapter and table numbers.
docs/refs/*.pdf
docs/refs/rm.txt
.coldtrace/
tools/ghidra/SHARC/data/languages/*.sla
tools/ghidra/ColdfireEMAC/data/languages/*.sla
tools/ghidra/ColdfireEMAC/extension.properties
tools/nbdocs-scrape.py

# tools/sharcspec: text extracts of the ADI manuals and generated renders and
# Ghidra language files. The PDFs themselves are covered by docs/refs/*.pdf.
docs/refs/pgr.txt
docs/refs/prm.txt
tools/sharcspec/renders/
tools/sharcspec/ghidra/SHARC_VISA/

# Session scratch: probe scripts and large intermediate dumps.
scratch/

# samples/: WAV files that become the emulated +Drive (tools/plusdrive.py).
# Never commit real recordings; the two test WAVs are also excluded and
# regenerated on demand instead (tools/gen_test_samples.py, samples/README.md).
samples/*.wav

# Rust build output for native/
native/**/target/

# JavaScript build artifacts
node_modules/
.astro/
dist/

# Temporary local agent worktrees.
.claude/worktrees/
