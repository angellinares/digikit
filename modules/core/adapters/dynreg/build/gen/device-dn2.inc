    .equ PANEL_EXC_CH_3, 0x6    /* [panel.exceptions] channel of the code */
    .equ PANEL_EXC_BIT_3, 0x5    /* [panel.exceptions] bit of the code */
    .equ PANEL_EXC_CODE_4, 0x35    /* [panel.exceptions] code */
    .equ PANEL_EXC_CH_4, 0x6    /* [panel.exceptions] channel of the code */
    .equ PANEL_EXC_BIT_4, 0x6    /* [panel.exceptions] bit of the code */
    .equ PANEL_EXC_CODE_5, 0x36    /* [panel.exceptions] code */
    .equ PANEL_EXC_CH_5, 0x6    /* [panel.exceptions] channel of the code */
    .equ PANEL_EXC_BIT_5, 0x7    /* [panel.exceptions] bit of the code */
    .equ PANEL_EXC_CODE_6, 0x0    /* [panel.exceptions] code */
