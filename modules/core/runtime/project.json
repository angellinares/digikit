{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "core/runtime",
  "implicitDependencies": ["dkrt-sdk", "dkrt-abi", "dkrt-fit", "dkrt-link", "dkrt-test-support", "dkrt-svc-fx", "dkrt-svc-machines", "dkrt-svc-lfo", "dkrt-svc-samples", "dkneeds", "dkfw"],
  "metadata": {
    "runtimeAcceptance": [{ "modules": ["test/svc-test", "test/svc-test-user"] }]
  },
  "targets": {
    "rust-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/src/rs/**/*",
        {
          "input": "production",
          "projects": ["dkrt-sdk", "dkrt-abi", "dkrt-fit", "dkrt-link", "dkrt-test-support", "dkrt-svc-fx", "dkrt-svc-machines", "dkrt-svc-lfo", "dkrt-svc-samples", "dkneeds", "dkfw"]
        },
        "{workspaceRoot}/.cargo/**/*",
        "{workspaceRoot}/rust-toolchain*",
        "{workspaceRoot}/mise.toml",
        "{workspaceRoot}/tools/nx/rust-env.mjs",
        "{workspaceRoot}/modules/core/runtime/tests/platform/contract.toml",
        "{workspaceRoot}/modules/core/runtime/tests/storage/contract.toml",
        "{workspaceRoot}/tests/fixtures/modules/{dyn-fx-gain,sine,svc-test,svc-test-user}/module.toml",
        "{workspaceRoot}/tests/fixtures/modules/{dyn-fx-gain,sine,svc-test,svc-test-user}/src/**/*",
        { "dependentTasksOutputFiles": "dist/modules/*/{dyn-fx-gain,sine,svc-test,svc-test-user}.*", "transitive": false }
      ],
      "dependsOn": ["test/dyn-fx-gain:pack", "test/sine:pack", "test/svc-test:pack", "test/svc-test-user:pack"],
      "outputs": [],
      "options": {
        "command": "node tools/nx/rust-env.mjs --variant host-dkrt -- cargo test --manifest-path modules/core/runtime/src/rs/Cargo.toml --lib --offline --locked -- --skip assembly_tests",
        "cwd": "."
      }
    },
    "test-assembly": {
      "executor": "nx:run-commands",
      "cache": true,
      "description": "Host assembly tests: the seams between the real packed outputs (fixtures, service files, bound files, the runtime object, the info table of the image) through the plan, the role checks and the installs of the boot over FakePlatform. Every test-device target depends on it.",
      "inputs": [
        "{projectRoot}/src/rs/**/*",
        {
          "input": "production",
          "projects": ["dkrt-sdk", "dkrt-abi", "dkrt-fit", "dkrt-link", "dkrt-test-support", "dkrt-svc-fx", "dkrt-svc-machines", "dkrt-svc-lfo", "dkrt-svc-samples", "dkneeds", "dkfw"]
        },
        "{workspaceRoot}/.cargo/**/*",
        "{workspaceRoot}/rust-toolchain*",
        "{workspaceRoot}/mise.toml",
        "{workspaceRoot}/tools/nx/rust-env.mjs",
        "{workspaceRoot}/modules/core/runtime/build/runtime.dko.json",
        "{workspaceRoot}/modules/core/services/fx/dks/build/fx.dko.json",
        "{workspaceRoot}/modules/core/services/machines/dks/build/machines.dko.json",
        "{workspaceRoot}/modules/core/services/lfo/dks/build/lfo.dko.json",
        "{workspaceRoot}/modules/core/services/{fx,machines,lfo}/dks/{Cargo.toml,src/**/*}",
        "{workspaceRoot}/tools/nx/device-images.mjs",
        "{workspaceRoot}/dist/modules/dt2/sine.dkm",
        "{workspaceRoot}/dist/modules/dt2/dyn-fx-gain.dkm",
        "{workspaceRoot}/dist/modules/dt2/lfo-shape.dkm",
        "{workspaceRoot}/dist/modules/dt2/svc-test-user.dkm",
        "{workspaceRoot}/dist/modules/dt2/fx.dks",
        "{workspaceRoot}/dist/modules/dt2/machines.dks",
        "{workspaceRoot}/dist/modules/dt2/lfo.dks",
        "{workspaceRoot}/dist/modules/dt2/svc-test.dks",
        "{workspaceRoot}/dist/svc-bound/dt2/fx.dks",
        "{workspaceRoot}/dist/svc-bound/dt2/machines.dks",
        "{workspaceRoot}/dist/svc-bound/dt2/svc-test.dks",
        "{workspaceRoot}/dist/bytes/images/dt2/set-emulator.info",
        "{workspaceRoot}/dist/bytes/images/dt2/set-device.info",
        "{workspaceRoot}/firmware/Digitakt_II_OS1.17.syx",
        "{workspaceRoot}/dist/modules/dn2/sine.dkm",
        "{workspaceRoot}/dist/modules/dn2/dyn-dn2.dkm",
        "{workspaceRoot}/dist/modules/dn2/dyn-fx-gain.dkm",
        "{workspaceRoot}/dist/modules/dn2/lfo-shape.dkm",
        "{workspaceRoot}/dist/modules/dn2/svc-test-user.dkm",
        "{workspaceRoot}/dist/modules/dn2/fx.dks",
        "{workspaceRoot}/dist/modules/dn2/machines.dks",
        "{workspaceRoot}/dist/modules/dn2/lfo.dks",
        "{workspaceRoot}/dist/modules/dn2/svc-test.dks",
        "{workspaceRoot}/dist/svc-bound/dn2/fx.dks",
        "{workspaceRoot}/dist/svc-bound/dn2/machines.dks",
        "{workspaceRoot}/dist/svc-bound/dn2/svc-test.dks",
        "{workspaceRoot}/dist/bytes/images/dn2/set-emulator.info",
        "{workspaceRoot}/dist/bytes/images/dn2/set-device.info",
        "{workspaceRoot}/firmware/Digitone_II_OS1.12.syx"
      ],
      "dependsOn": [
        "test/sine:pack",
        "test/dyn-dn2:pack",
        "test/dyn-fx-gain:pack",
        "test/lfo-shape:pack",
        "test/svc-test-user:pack",
        "test/svc-test:pack",
        "core/services/fx:pack",
        "core/services/machines:pack",
        "core/services/lfo:pack",
        "core/services/fx:bind",
        "core/services/machines:bind",
        "test/svc-test:bind",
        "patchkit:device-images"
      ],
      "outputs": [],
      "options": {
        "command": "node tools/nx/rust-env.mjs --variant host-dkrt -- cargo test --manifest-path modules/core/runtime/src/rs/Cargo.toml --lib --offline --locked assembly_tests",
        "cwd": "."
      }
    }
  }
}
