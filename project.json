{
  "name": "workspace",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["{workspaceRoot}/**/*"],
      "options": { "command": "pnpm lint", "cwd": "." }
    },
    "fmt-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["{workspaceRoot}/**/*"],
      "options": { "command": "pnpm fmt:check", "cwd": "." }
    }
  }
}
