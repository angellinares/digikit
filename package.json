{
  "name": "digikit",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @digi/web dev",
    "build": "pnpm --filter @digi/web build",
    "lint": "oxlint",
    "fmt": "prettier --write . '!out/**' '!**/target/**' '!**/gen/**' '!**/dist/**' '!**/.astro/**' '!apps/web/.local/**'",
    "fmt:check": "prettier --check . '!out/**' '!**/target/**' '!**/gen/**' '!**/dist/**' '!**/.astro/**' '!apps/web/.local/**'",
    "test:host": "vitest run --config vitest.host.config.ts",
    "nx:pilot": "NX_CACHE_DIRECTORY=\"$PWD/.nx/cache\" NX_WORKSPACE_DATA_DIRECTORY=\"$PWD/.nx/workspace-data\" NX_DAEMON=false NX_NO_CLOUD=true nx",
    "verify:host": "oxlint && pnpm fmt:check && pnpm test:host && pnpm -r run typecheck"
  },
  "devDependencies": {
    "@nx/devkit": "22.7.12",
    "eslint-plugin-solid": "0.18.1",
    "nx": "22.7.12",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "smol-toml": "1.9.0",
    "vitest": "3.2.4"
  }
}
