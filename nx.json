{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cacheDirectory": ".nx/cache",
  "neverConnectToCloud": true,
  "analytics": false,
  "plugins": ["./tools/nx/modules.mjs", "./tools/nx/cargo.mjs"],
  "release": {
    "groups": {
      "modules": {
        "projects": ["tag:release-module"],
        "projectsRelationship": "independent",
        "releaseTag": { "pattern": "{projectName}@{version}" }
      },
      "runtime": {
        "projects": ["core/runtime"],
        "projectsRelationship": "fixed",
        "releaseTag": { "pattern": "runtime@{version}" },
        "version": {
          "manifestRootsToUpdate": ["sdk"],
          "versionActionsOptions": {
            "manifestFilename": "sdk.toml",
            "versionTable": "runtime",
            "mirrorProjectManifest": true
          }
        }
      }
    },
    "version": {
      "versionActions": "./tools/nx/release-version-actions.cjs",
      "currentVersionResolver": "disk",
      "specifierSource": "prompt",
      "updateDependents": "never",
      "adjustSemverBumpsForZeroMajorVersion": false,
      "git": { "commit": false, "stageChanges": false, "tag": false, "push": false }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": false,
      "git": { "commit": false, "stageChanges": false, "tag": false, "push": false }
    }
  },
  "namedInputs": {
    "hostTests": [
      "{projectRoot}/**/*",
      "jsToolchain",
      "{workspaceRoot}/vitest.host.config.ts",
      "{workspaceRoot}/vitest.host.projects.json",
      "{workspaceRoot}/tsconfig*.json",
      {
        "externalDependencies": ["vitest"]
      }
    ],
    "jsToolchain": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/nx.json",
      {
        "runtime": "node -p 'JSON.stringify({versions:process.versions,platform:process.platform,arch:process.arch})'"
      },
      {
        "runtime": "pnpm --version"
      },
      {
        "env": "NODE_OPTIONS"
      },
      {
        "env": "NODE_ENV"
      },
      {
        "env": "CI"
      },
      {
        "env": "TZ"
      },
      {
        "env": "LANG"
      },
      {
        "env": "LC_ALL"
      }
    ],
    "production": ["default", "!{projectRoot}/tests/**/*", "!{projectRoot}/**/*.md"]
  },
  "targetDefaults": {
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production", "jsToolchain"],
      "outputs": []
    }
  },
  "parallel": 3
}
