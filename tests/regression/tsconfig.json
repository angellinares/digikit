{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@digi/regression/*": ["./*"],
      "@digi/test-support": ["../../packages/test-support/src/index.ts"],
      "@digi/control-client": ["../../packages/control-client/src/index.ts"],
      "@digi/dkbs": ["../../packages/dkbs/src/index.ts"],
      "@digi/dk-session": ["../../packages/dk-session/src/index.ts"],
      "@digi/dk-session/*": ["../../packages/dk-session/src/*.ts"]
    }
  },
  "include": [
    "*.ts",
    "dt2",
    "runtime",
    "emulator",
    "host",
    "scenarios",
    "../conformance",
    "../fixtures/modules/**/tests/**/*.device.test.ts",
    "../../modules/**/tests/**/*.device.test.ts"
  ]
}
