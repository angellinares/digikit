{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "regression",
  "implicitDependencies": ["control-client", "@digi/test-support", "@digi/dk-session"],
  "targets": {
    "test:stock": {
      "executor": "nx:run-script",
      "options": { "script": "test:stock" },
      "dependsOn": ["digi-control:daemons"],
      "parallelism": false
    },
    "test:fx": {
      "dependsOn": ["digi-coupled:build"],
      "parallelism": false,
      "options": { "env": { "DIGI_FX_NO_AOT_SUBSET": "0" } }
    },
    "test:fx-no-aot": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["digi-coupled:build"],
      "options": {
        "command": "uv run python -m tools.devtools.fx_tier exec-no-aot -- pnpm --filter @digi/regression test:fx",
        "env": { "DIGI_FX_NO_AOT_SUBSET": "1" },
        "cwd": "."
      }
    },
    "test:fx:dt2": {
      "dependsOn": ["digi-coupled:build-dt2"],
      "parallelism": false,
      "options": { "env": { "DIGI_FX_NO_AOT_SUBSET": "0" } }
    },
    "test-device": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": [
        "patchkit:cli",
        "digi-control:daemons",
        "digikit/probe:pack",
        "digikit/remote:pack",
        "test/dsp-facts:pack",
        "test/sharc-probe:pack",
        "test/step-beacon:pack"
      ],
      "outputs": [],
      "options": {
        "command": "pnpm --filter @digi/regression test:runtime emulator/",
        "cwd": "."
      }
    },
    "test-host": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "hostTests",
        "^hostTests",
        "{workspaceRoot}/tools/emulator/fast_regions.json",
        "{workspaceRoot}/devices/*.toml",
        "{workspaceRoot}/sdk/vectors/**/*",
        {
          "runtime": "shasum -a 256 out/native/target/nogen/release/plusdrive 2>/dev/null || echo no-plusdrive"
        }
      ],
      "outputs": [],
      "options": {
        "forwardAllArgs": false,
        "command": "pnpm exec vitest run --config vitest.host.config.ts --project regression-host",
        "cwd": "."
      }
    }
  },
  "metadata": {
    "runtimeAcceptance": [
      {
        "files": ["emulator/reply-inflight.test.ts"],
        "modules": []
      },
      {
        "files": ["emulator/sharc-semantics.test.ts"],
        "modules": ["digikit/probe", "digikit/remote", "test/dsp-facts", "test/sharc-probe", "test/step-beacon"]
      }
    ]
  }
}
