{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "gate-smoke",
  "description": "Patchkit smoke matrix (tests/patchkit/smoke/matrix.toml). Inputs: the Python harness closure, the daemon sources, the core modules and fixtures the matrix names.",
  "targets": {
    "smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["digi-control:daemons"],
      "inputs": [
        "{workspaceRoot}/tools/__init__.py",
        "{workspaceRoot}/tools/patchkit/pk_harness.py",
        "{workspaceRoot}/tools/patchkit/patchkit.py",
        "{workspaceRoot}/tools/patchkit/modroots.py",
        "{workspaceRoot}/tools/patchkit/pk_emud_pgo.py",
        "{workspaceRoot}/tools/patchkit/pk_dsp_budget.py",
        "{workspaceRoot}/tools/patchkit/pk_mem.py",
        "{workspaceRoot}/tools/patchkit/pk_device.py",
        "{workspaceRoot}/tools/control/digi_client.py",
        "{workspaceRoot}/tools/emulator/card_check.py",
        "{workspaceRoot}/tools/emulator/digi_env.py",
        "{workspaceRoot}/tools/emulator/native_target.py",
        "{workspaceRoot}/tools/emulator/native_pgo.py",
        "{workspaceRoot}/tools/emulator/native_emu.py",
        "{workspaceRoot}/tools/emulator/fast_regions.json",
        "{workspaceRoot}/tools/emulator/ready_inputs.json",
        "{workspaceRoot}/tools/firmware/config.py",
        "{workspaceRoot}/tools/firmware/device.py",
        "{workspaceRoot}/tools/device/dklog_kinds.py",
        "{workspaceRoot}/tools/devtools/benchlock.py",
        "{workspaceRoot}/tools/devtools/portable_flock.py",
        "{workspaceRoot}/tools/devtools/stablebin.py",
        "{workspaceRoot}/tools/devtools/emud_key.py",
        "{workspaceRoot}/tools/devtools/verify_build.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_core/**/*.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_transpile/**/*.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_transpile_infer.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_rsgen.py",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/packages/emulator/**/*",
        "{workspaceRoot}/packages/dkneeds/**/*",
        "{workspaceRoot}/packages/dksample/**/*",
        "{workspaceRoot}/packages/dkupload/**/*",
        "{workspaceRoot}/packages/patchkit/**/*",
        "{workspaceRoot}/modules/core/runtime/fit/Cargo.toml",
        "{workspaceRoot}/modules/core/runtime/fit/src/**/*",
        "{workspaceRoot}/modules/core/runtime/sdk/Cargo.toml",
        "{workspaceRoot}/modules/core/runtime/sdk/src/**/*",
        "{workspaceRoot}/devices/**/*",
        "{workspaceRoot}/tests/scenarios/dn2.json",
        "{workspaceRoot}/sdk/sdk.toml",
        "{workspaceRoot}/tools/patchkit/toolchain/**/*",
        "{workspaceRoot}/tools/nx/daemon-env.mjs",
        "{workspaceRoot}/tests/patchkit/smoke/matrix.toml",
        "{workspaceRoot}/tests/patchkit/smoke/goldens.json",
        "{workspaceRoot}/tests/patchkit/smoke/tours/**/*",
        "{workspaceRoot}/modules/**/module.toml",
        "{workspaceRoot}/tests/fixtures/modules/**/module.toml",
        "{workspaceRoot}/sdk/include/**/*",
        "{workspaceRoot}/modules/core/adapters/machines/build/**/*",
        "{workspaceRoot}/modules/core/adapters/machines/src/**/*",
        "{workspaceRoot}/modules/core/adapters/machines/include/**/*",
        "{workspaceRoot}/modules/core/adapters/machines/tests/*.toml",
        "{workspaceRoot}/modules/core/adapters/params/build/**/*",
        "{workspaceRoot}/modules/core/adapters/params/src/**/*",
        "{workspaceRoot}/modules/core/adapters/params/include/**/*",
        "{workspaceRoot}/modules/core/adapters/params/tests/*.toml",
        "{workspaceRoot}/modules/core/adapters/dsp-voice/build/**/*",
        "{workspaceRoot}/modules/core/adapters/dsp-voice/src/**/*",
        "{workspaceRoot}/modules/core/adapters/dsp-voice/include/**/*",
        "{workspaceRoot}/modules/core/adapters/dsp-voice/tests/*.toml",
        "{workspaceRoot}/modules/core/adapters/dsp-link/build/**/*",
        "{workspaceRoot}/modules/core/adapters/dsp-link/src/**/*",
        "{workspaceRoot}/modules/core/adapters/dsp-link/include/**/*",
        "{workspaceRoot}/modules/core/adapters/dsp-link/tests/*.toml",
        "{workspaceRoot}/modules/core/adapters/fx/build/**/*",
        "{workspaceRoot}/modules/core/adapters/fx/src/**/*",
        "{workspaceRoot}/modules/core/adapters/fx/include/**/*",
        "{workspaceRoot}/modules/core/adapters/fx/tests/*.toml",
        "{workspaceRoot}/modules/core/adapters/ui/build/**/*",
        "{workspaceRoot}/modules/core/adapters/ui/src/**/*",
        "{workspaceRoot}/modules/core/adapters/ui/include/**/*",
        "{workspaceRoot}/modules/core/adapters/ui/tests/*.toml",
        "{workspaceRoot}/modules/core/apps/digikit-menu/build/**/*",
        "{workspaceRoot}/modules/core/apps/digikit-menu/src/**/*",
        "{workspaceRoot}/modules/core/apps/digikit-menu/include/**/*",
        "{workspaceRoot}/modules/core/apps/digikit-menu/tests/*.toml",
        "{workspaceRoot}/modules/core/runtime/build/**/*",
        "{workspaceRoot}/modules/core/runtime/src/**/*",
        "{workspaceRoot}/modules/core/runtime/include/**/*",
        "{workspaceRoot}/modules/core/runtime/tests/*.toml",
        "{workspaceRoot}/modules/core/expansion/build/**/*",
        "{workspaceRoot}/modules/core/expansion/src/**/*",
        "{workspaceRoot}/modules/core/expansion/include/**/*",
        "{workspaceRoot}/modules/core/expansion/tests/*.toml",
        "{workspaceRoot}/tests/fixtures/modules/machine-clone/**/*",
        "{workspaceRoot}/tests/fixtures/modules/patched-pluck/**/*",
        "{workspaceRoot}/tests/fixtures/modules/rust-demo/**/*",
        "{workspaceRoot}/tests/fixtures/modules/cf-demo/**/*",
        "{workspaceRoot}/tests/fixtures/modules/dn2-clone/**/*",
        "{workspaceRoot}/tests/fixtures/modules/dn2-pages/**/*",
        "{workspaceRoot}/tests/fixtures/modules/fx-gain/**/*"
      ],
      "options": {
        "command": "node tools/nx/daemon-env.mjs -- uv run python -m tools.patchkit.pk_harness run --jobs ${DIGI_JOBS:-4}",
        "cwd": "."
      }
    }
  }
}
