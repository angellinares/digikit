{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "gate-fx-dn2",
  "description": "DN2 FX oracles: the Vitest fx-dn2 suite with and without AOT, and the DN2 tier runs.",
  "namedInputs": {
    "fxDn2": [
      "{workspaceRoot}/tools/__init__.py",
      "{workspaceRoot}/tools/emulator/coupled.py",
      "{workspaceRoot}/tools/emulator/digi_env.py",
      "{workspaceRoot}/tools/emulator/native_target.py",
      "{workspaceRoot}/config/emulator.json",
      "{workspaceRoot}/tools/emulator/ready_inputs.json",
      "{workspaceRoot}/tools/firmware/config.py",
      "{workspaceRoot}/tools/firmware/device.py",
      "{workspaceRoot}/tools/devtools/render_cache.py",
      "{workspaceRoot}/tools/devtools/benchlock.py",
      "{workspaceRoot}/tools/devtools/portable_flock.py",
      "{workspaceRoot}/tools/sharc_dev/sharc_core/**/*.py",
      "{workspaceRoot}/tools/sharc_dev/sharc_transpile/**/*.py",
      "{workspaceRoot}/tools/sharc_dev/sharc_transpile_infer.py",
      "{workspaceRoot}/tools/sharc_dev/sharc_rsgen.py",
      "{workspaceRoot}/packages/emulator/coupled/**/*",
      "{workspaceRoot}/packages/emulator/boot/**/*",
      "{workspaceRoot}/packages/emulator/device-profile/**/*",
      "{workspaceRoot}/packages/emulator/loader/**/*",
      "{workspaceRoot}/packages/emulator/plusdrive/**/*",
      "{workspaceRoot}/packages/emulator/card/**/*",
      "{workspaceRoot}/packages/emulator/machine/**/*",
      "{workspaceRoot}/packages/emulator/periph/**/*",
      "{workspaceRoot}/packages/emulator/coldfire/**/*",
      "{workspaceRoot}/packages/emulator/live/**/*",
      "{workspaceRoot}/packages/emulator/sharc/**/*",
      "{workspaceRoot}/packages/emulator/sharc-rt/**/*",
      "{workspaceRoot}/packages/emulator/sharc-stats/**/*",
      "{workspaceRoot}/packages/emulator/sharc-gen/**/*",
      "{workspaceRoot}/packages/emulator/sharc-fast-cl/**/*",
      "{workspaceRoot}/tests/scenarios/dn2.json",
      "{workspaceRoot}/devices/*.toml",
      "{workspaceRoot}/sdk/sdk.toml",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/tests/regression/scenarios/fx-support.ts",
      "{workspaceRoot}/tests/regression/vitest.config.ts",
      "{workspaceRoot}/tests/regression/package.json",
      "{workspaceRoot}/packages/test-support/**/*",
      "{workspaceRoot}/packages/control-client/**/*",
      "{workspaceRoot}/tools/emulator/fxcheck.py",
      "{workspaceRoot}/tools/emulator/audiocheck.py",
      "{workspaceRoot}/tools/coldfire/paramtable.py",
      "{workspaceRoot}/tools/patchkit/machineprofile.py",
      "{workspaceRoot}/tools/devtools/fx_tier.py",
      "{workspaceRoot}/tools/devtools/fastcov.py",
      "{workspaceRoot}/tests/regression/scenarios/dn2-trackfx.ts",
      "{workspaceRoot}/tests/regression/scenarios/dn2-trackfx.test.ts",
      "{workspaceRoot}/tests/regression/scenarios/dn2-sendfx.ts",
      "{workspaceRoot}/tests/regression/scenarios/dn2-sendfx.test.ts",
      "{workspaceRoot}/tests/scenarios/dn2-fx.json"
    ]
  },
  "targets": {
    "fx": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": true,
      "dependsOn": ["digi-coupled:build"],
      "inputs": ["fxDn2"],
      "options": {
        "command": "pnpm --filter @digi/regression test:fx",
        "env": { "DIGI_JOBS": "1" },
        "cwd": "."
      }
    },
    "fx-no-aot": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": true,
      "dependsOn": ["digi-coupled:build"],
      "inputs": ["fxDn2"],
      "options": {
        "command": "uv run python -m tools.devtools.fx_tier exec-no-aot -- pnpm --filter @digi/regression test:fx",
        "env": { "DIGI_FX_NO_AOT_SUBSET": "1", "DIGI_JOBS": "1" },
        "cwd": "."
      }
    },
    "tier-quick": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["digi-coupled:build"],
      "inputs": ["fxDn2"],
      "options": { "command": "uv run python -m tools.devtools.fx_tier tier-quick", "cwd": "." }
    },
    "tier-sweep": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["digi-coupled:build"],
      "inputs": ["fxDn2"],
      "options": { "command": "uv run python -m tools.devtools.fx_tier tier-sweep", "cwd": "." }
    }
  }
}
