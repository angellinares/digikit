{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "gate-card",
  "targets": {
    "card": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": true,
      "dependsOn": ["digi-control:daemons"],
      "outputs": [],
      "inputs": [
        "{workspaceRoot}/tools/__init__.py",
        "{workspaceRoot}/tools/patchkit/pk_harness.py",
        "{workspaceRoot}/tools/patchkit/patchkit.py",
        "{workspaceRoot}/tools/patchkit/modroots.py",
        "{workspaceRoot}/tools/patchkit/pk_emud_pgo.py",
        "{workspaceRoot}/tools/patchkit/pk_dsp_budget.py",
        "{workspaceRoot}/tools/patchkit/pk_mem.py",
        "{workspaceRoot}/tools/patchkit/pk_device.py",
        "{workspaceRoot}/tools/control/digi_client.py",
        "{workspaceRoot}/tools/emulator/card_check.py",
        "{workspaceRoot}/tools/emulator/digi_env.py",
        "{workspaceRoot}/tools/emulator/native_target.py",
        "{workspaceRoot}/tools/emulator/native_pgo.py",
        "{workspaceRoot}/tools/emulator/native_emu.py",
        "{workspaceRoot}/config/emulator.json",
        "{workspaceRoot}/tools/emulator/ready_inputs.json",
        "{workspaceRoot}/tools/firmware/config.py",
        "{workspaceRoot}/tools/firmware/device.py",
        "{workspaceRoot}/tools/device/dklog_kinds.py",
        "{workspaceRoot}/tools/devtools/benchlock.py",
        "{workspaceRoot}/tools/devtools/portable_flock.py",
        "{workspaceRoot}/tools/devtools/stablebin.py",
        "{workspaceRoot}/tools/devtools/emud_key.py",
        "{workspaceRoot}/tools/devtools/verify_build.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_core/**/*.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_transpile/**/*.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_transpile_infer.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_rsgen.py",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/packages/emulator/**/*",
        "{workspaceRoot}/packages/dkneeds/**/*",
        "{workspaceRoot}/packages/dksample/**/*",
        "{workspaceRoot}/packages/dkupload/**/*",
        "{workspaceRoot}/packages/patchkit/**/*",
        "{workspaceRoot}/modules/core/runtime/fit/Cargo.toml",
        "{workspaceRoot}/modules/core/runtime/fit/src/**/*",
        "{workspaceRoot}/modules/core/runtime/sdk/Cargo.toml",
        "{workspaceRoot}/modules/core/runtime/sdk/src/**/*",
        "{workspaceRoot}/devices/**/*",
        "{workspaceRoot}/tests/scenarios/dn2.json",
        "{workspaceRoot}/sdk/sdk.toml",
        "{workspaceRoot}/tools/patchkit/toolchain/**/*",
        "{workspaceRoot}/tools/nx/daemon-env.mjs",
        "{workspaceRoot}/tools/firmware/plusdrive_check.py",
        "{workspaceRoot}/tools/device/dkproto.py",
        "{workspaceRoot}/tools/device/dksettings.py",
        "{workspaceRoot}/tools/device/dktiming.py",
        "{workspaceRoot}/tools/device/dkupload.py",
        "{workspaceRoot}/tools/device/midisniff.py",
        "{workspaceRoot}/tools/device/winmidi.py",
        "{workspaceRoot}/tools/devtools/render_cache.py",
        "{workspaceRoot}/tools/emulator/coupled.py",
        "{workspaceRoot}/tools/emulator/dt2_sample_check.py",
        "{workspaceRoot}/tools/emulator/emulator_config.py",
        "{workspaceRoot}/tools/firmware/aplib.py",
        "{workspaceRoot}/tools/firmware/aplibpack.py",
        "{workspaceRoot}/tools/firmware/authcode.py",
        "{workspaceRoot}/tools/firmware/build.py",
        "{workspaceRoot}/tools/firmware/container.py",
        "{workspaceRoot}/tools/firmware/elz.py",
        "{workspaceRoot}/tools/firmware/extract.py",
        "{workspaceRoot}/tools/patchkit/dsp_patch.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_asm.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_disasm.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_isa.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_trace.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_visa_tables.py",
        "{workspaceRoot}/tools/sharc_dev/sharcimm.py",
        "{workspaceRoot}/tools/sharc_dev/sharcldr.py",
        { "dependentTasksOutputFiles": "**/*", "transitive": true },
        { "runtime": "node tools/nx/device-inputs.mjs" },
        { "runtime": "node tools/nx/coupled-inputs.mjs" },
        { "env": "DIGI_FX_SWEEP" },
        { "env": "DIGI_FX_NO_AOT_SUBSET" },
        { "env": "DIGI_EMU_FAST" },
        { "env": "DIGI_NO_PROGRESS_MS" },
        { "env": "DIGI_DT2_CARD" },
        { "env": "DIGI_COUPLED_FEATURES" },
        { "env": "SHARC_AOT" },
        { "env": "SHARC_FAST_REGIONS" },
        { "env": "SHARC_BLOCKTRANS" },
        { "env": "SHARC_FAST_FALLBACK_REGIONS" },
        { "env": "SHARC_FAST_AUTO" },
        { "env": "SHARC_GEN_DIR" },
        { "env": "SHARC_GEN_DIR_2" },
        { "env": "UPDATE_GOLDENS" }
      ],
      "options": {
        "commands": [
          "node tools/devtools/emu-slot.mjs -- node tools/nx/daemon-env.mjs -- uv run python -m tools.emulator.card_check",
          "node tools/devtools/emu-slot.mjs -- uv run python -m tools.firmware.plusdrive_check",
          "node tools/devtools/emu-slot.mjs -- uv run python -m tools.firmware.plusdrive_check --dn2"
        ],
        "parallel": false,
        "cwd": "."
      }
    }
  }
}
