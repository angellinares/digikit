        "{workspaceRoot}/tools/devtools/fastcov.py",
        "{workspaceRoot}/tools/emulator/dt2_sample_check.py",
        "{workspaceRoot}/tools/emulator/native_emu.py",
        "{workspaceRoot}/tools/emulator/ready.py",
        "{workspaceRoot}/tests/regression/scenarios/dt2-fx.test.ts",
        "{workspaceRoot}/tests/regression/scenarios/dt2-trackfx.ts",
        "{workspaceRoot}/tests/regression/scenarios/dt2-sendfx.ts"
      ],
      "options": {
        "command": "pnpm --filter @digi/regression test:fx:dt2",
