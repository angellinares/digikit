{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "tools",
  "targets": {
    "python-checks": {
      "executor": "nx:run-commands",
      "description": "Runs on any change; py_select filters by diff and exits fast when nothing applies.",
      "cache": false,
      "inputs": ["{workspaceRoot}/**/*"],
      "options": { "command": "uv run python -m tools.devtools.py_select checks", "cwd": "." }
    },
    "python-tests": {
      "executor": "nx:run-commands",
      "description": "Runs on any change; py_select filters by diff and exits fast when nothing applies.",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["digi-control:daemons"],
      "inputs": ["{workspaceRoot}/**/*"],
      "options": {
        "command": "uv run python -m tools.devtools.py_select run --base ${DIGI_GATE_BASE:-origin/main}",
        "cwd": "."
      }
    }
  }
}
