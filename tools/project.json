{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "tools",
  "namedInputs": {
    "pythonGate": [
      "{workspaceRoot}/tools/**/*",
      "{workspaceRoot}/tests/**/*",
      "{workspaceRoot}/packages/patchkit/**/*",
      "{workspaceRoot}/packages/dkneeds/**/*",
      "{workspaceRoot}/packages/emulator/control/**/*",
      "{workspaceRoot}/packages/emulator/plusdrive/**/*",
      "{workspaceRoot}/modules/**/*",
      "{workspaceRoot}/sdk/**/*",
      "{workspaceRoot}/devices/**/*",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock"
    ]
  },
  "targets": {
    "python-checks": {
      "executor": "nx:run-commands",
      "description": "ruff, ruff format, mypy, layercheck and gen-check on changes to tools, tests, modules, sdk, devices, Python and Cargo manifests, and the patchkit, dkneeds, control and plusdrive packages. Nx affected ignores negated inputs, so the inputs list the directories.",
      "cache": false,
      "inputs": ["pythonGate"],
      "options": { "command": "uv run python -m tools.devtools.py_select checks", "cwd": "." }
    },
    "python-tests": {
      "executor": "nx:run-commands",
      "description": "py_select picks the tests from the diff against DIGI_GATE_BASE; tests/patchkit/test_pk_current.py always runs. Selected only for changes in the scope of python-checks.",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["digi-control:daemons"],
      "inputs": ["pythonGate"],
      "options": {
        "command": "uv run python -m tools.devtools.py_select run --base ${DIGI_GATE_BASE:-main}",
        "cwd": "."
      }
    }
  }
}
