---
// A still picture of a device: the emulator's own panel drawing, optionally "playing" (trigs 1, 5, 9 and 13
// lit in the device accent) with a screenshot of the MODULES list on the OLED. Server-rendered; no emulator runs.
import PanelArt from './PanelArt';
import { panels } from '../data/faceplates';
import type { Key } from '../data/faceplates';
import type { DeviceId } from '../data/device-profiles';

interface Props {
  device: DeviceId;
  playing?: boolean;
  label?: string;
  class?: string;
}
const { device, playing = false, label, class: className } = Astro.props;
const panel = panels[device];
// An empty label marks the picture as decoration (it sits next to the device name).
const decorative = label === '';
const lit = new Set(['1', '5', '9', '13']);
const keyLight = (key: Key) =>
  playing && key.style === 'trig' && lit.has(key.legend ?? '') ? `--lit: 1; --lit-color: ${panel.accent}` : undefined;
const [gx0, gy0, gx1, gy1] = panel.glass;
const oled = `left: ${(gx0 / 215) * 100}%; top: ${(gy0 / 176) * 100}%; width: ${((gx1 - gx0) / 215) * 100}%; height: ${((gy1 - gy0) / 176) * 100}%`;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div
  class:list={['device-art', className]}
  style={`--accent: ${panel.accent}; --func-legend: ${panel.func_legend}`}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : (label ?? `${panel.name} front panel`)}
  aria-hidden={decorative ? 'true' : undefined}
>
  <PanelArt panel={panel} keyLight={keyLight}>
    {playing && <img class="oled oled-art" style={oled} src={`${base}images/device-modules.png`} alt="" />}
  </PanelArt>
</div>

<style is:global>
  .device-art {
    width: 100%;
  }
  .device-art .panel-surface {
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.55));
  }
  .device-art .oled-art {
    image-rendering: pixelated;
    object-fit: contain;
  }
  /* Static art: no pointer affordances. */
  .device-art .knob,
  .device-art .key {
    cursor: default;
  }
</style>
