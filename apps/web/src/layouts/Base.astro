---
// Shared page shell: fonts, tokens, the site navigation, and the COI service worker, which only the emulator needs
// (GitHub Pages cannot send COOP/COEP headers; the worker adds them so SharedArrayBuffer works after the first reload).
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/silkscreen/400.css';
import '../styles/site.css';
import { SHOW_EMULATOR } from '../../site.config.mjs';
interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'firmware' | 'emulator' | 'modules' | 'transfer';
  /** The page fills the window instead of scrolling (the emulator). */
  fill?: boolean;
}
const { title, description, active, fill = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const current = (page: Props['active']) => (active === page ? 'page' : undefined);
// The commit this site was built from. Actions sets GITHUB_SHA; local builds have none and show no footer.
const commit = process.env.GITHUB_SHA;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0c0e" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    {SHOW_EMULATOR && <script is:inline src={`${base}coi-serviceworker.js`}></script>}
  </head>
  <body class:list={{ fill }}>
    <header class="sitenav">
      <div class="wrap">
        <a class="brand" href={base}>
          <span class="brand-mark" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </span>
          digikit
        </a>
        <nav class="nav-links" aria-label="Main">
          <a href={`${base}firmware/`} aria-current={current('firmware')}>
            Firmware
          </a>
          {SHOW_EMULATOR && (
            <a href={`${base}emulator/`} aria-current={current('emulator')}>
              Emulator
            </a>
          )}
          <a href={`${base}modules/`} aria-current={current('modules')}>
            Modules
          </a>
          <a href={`${base}transfer/`} aria-current={current('transfer')}>
            Transfer
          </a>
        </nav>
        <a class="nav-source" href="https://github.com/ElekLabs/digikit">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M5.5 4.5L2 8L5.5 11.5M10.5 4.5L14 8L10.5 11.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          <span>Source</span>
        </a>
      </div>
    </header>
    <slot />
    {commit && !fill && (
      <footer class="sitefoot">
        <div class="wrap">
          Built from <a href={`https://github.com/ElekLabs/digikit/commit/${commit}`}>{commit.slice(0, 8)}</a>
        </div>
      </footer>
    )}
  </body>
</html>
