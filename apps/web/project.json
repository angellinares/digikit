{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@digi/web",
  "implicitDependencies": [
    "control-client",
    "@digi/dk-session",
    "patchkit",
    "dkupload",
    "dksample",
    "devices",
    "dkui-host"
  ],
  "targets": {
    "patchkit-wasm": {
      "executor": "nx:run-commands",
      "cache": true,
      "description": "Builds patchkit.wasm, dkupload.wasm and dksample.wasm into public/. The cargo wasm build recompiles on every call, so Nx replays it when the inputs are unchanged.",
      "inputs": [
        "production",
        "^production",
        "jsToolchain",
        "{workspaceRoot}/tools/nx/wasm.mjs",
        "{workspaceRoot}/tools/nx/rust-env.mjs",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/.cargo/**/*",
        "{workspaceRoot}/rust-toolchain*",
        "{workspaceRoot}/sdk/sdk.toml",
        "{workspaceRoot}/modules/core/runtime/vectors/**/*",
        "{workspaceRoot}/devices/*.toml",
        "{workspaceRoot}/tools/patchkit/toolchain/**/*",
        { "runtime": "rustc -vV" },
        { "runtime": "command -v wasm-opt >/dev/null && wasm-opt --version || echo no-wasm-opt" }
      ],
      "outputs": [
        "{workspaceRoot}/apps/web/public/patchkit.wasm",
        "{workspaceRoot}/apps/web/public/dkupload.wasm",
        "{workspaceRoot}/apps/web/public/dksample.wasm"
      ],
      "options": {
        "command": "node tools/nx/wasm.mjs --patchkit-only",
        "cwd": "."
      }
    },
    "test": {
      "dependsOn": ["patchkit-wasm"],
      "inputs": [
        "default",
        "^production",
        "jsToolchain",
        "{workspaceRoot}/apps/desktop/ui/src/card-core.ts",
        "{workspaceRoot}/apps/desktop/ui/src/samples-core.ts"
      ]
    },
    "check": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "jsToolchain",
        "{workspaceRoot}/config/emulator.json",
        "{workspaceRoot}/tools/emulator/ready_inputs.json",
        "{workspaceRoot}/modules/**/module.toml",
        "{workspaceRoot}/modules/**/gallery/icon.svg",
        "{workspaceRoot}/apps/desktop/ui/src/**/*",
        "{workspaceRoot}/apps/desktop/package.json"
      ],
      "outputs": ["{projectRoot}/.astro"],
      "description": "astro check; it writes .astro/*.d.ts before it checks (the audit lists them as generated)."
    },
    "test-host": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["patchkit-wasm"],
      "inputs": ["hostTests"],
      "outputs": [],
      "options": {
        "forwardAllArgs": false,
        "command": "pnpm exec vitest run --config vitest.host.config.ts --project web-transfer",
        "cwd": ".",
        "env": {
          "DIGI_FW_EMU_SOCKET": ""
        }
      }
    }
  }
}
