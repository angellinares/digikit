{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@digi/web",
  "implicitDependencies": [
    "control-client",
    "@digi/dk-session",
    "patchkit",
    "dkupload",
    "dksample",
    "devices",
    "dkui-host"
  ],
  "targets": {
    "patchkit-wasm": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "uv run python -m tools.emulator.native_wasm --patchkit-only",
        "cwd": "."
      }
    },
    "test": {
      "dependsOn": ["patchkit-wasm"]
    },
    "test-host": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["hostTests"],
      "outputs": [],
      "options": {
        "forwardAllArgs": false,
        "command": "pnpm exec vitest run --config vitest.host.config.ts --project web-transfer",
        "cwd": ".",
        "env": { "DIGI_FW_EMU_SOCKET": "" }
      }
    }
  }
}
